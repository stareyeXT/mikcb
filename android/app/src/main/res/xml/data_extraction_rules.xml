<?xml version="1.0" encoding="utf-8"?>
<!-- dataExtractionRules（Android 12+）：云备份与设备迁移排除项 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
    </device-transfer>
</data-extraction-rules>
